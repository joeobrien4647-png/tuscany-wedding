{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
    ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
    "public": {
      "profiles": {
        "$uid": {
          ".validate": "newData.hasChildren(['name'])"
        }
      },
      "config": {
        ".read": true
      }
    },
    "registrations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['name', 'email', 'intent'])"
      }
    },
    "members": {
      "payment": {
        ".read": "auth != null && root.child('approved').child(auth.uid).val() === true"
      }
    },
    "approved": {
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },
    "payments": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "welcome": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$token": {
        ".read": true,
        ".validate": "newData.hasChildren(['display', 'lines'])",
        "people": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        }
      }
    },
    "household": {
      "$token": {
        ".read": true,
        ".validate": "root.child('welcome').child($token).exists()",
        "reply": {
          ".write": "now < 1803859200000",
          ".validate": "newData.hasChildren(['answer', 'coming', 'at'])",
          "answer": { ".validate": "newData.val() === 'yes' || newData.val() === 'no'" },
          "coming": { ".validate": "newData.hasChildren()", "$i": { ".validate": "newData.isBoolean() && $i.matches(/^[0-7]$/)" } },
          "at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        },
        "stay": {
          ".write": "root.child('household').child($token).child('reply').child('answer').val() === 'yes' && (now < 1803859200000 || !data.exists() || data.child('choice').val() === 'later')",
          ".validate": "newData.hasChildren(['choice', 'at'])",
          "choice": { ".validate": "newData.val() === 'villa' || newData.val() === 'own' || newData.val() === 'later'" },
          "at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        },
        "food": {
          ".write": "now < 1803859200000 && root.child('household').child($token).child('reply').child('answer').val() === 'yes'",
          ".validate": "newData.hasChildren(['at'])",
          "at": { ".validate": "newData.val() == now" },
          "people": {
            ".validate": "newData.hasChildren()",
            "$i": {
              ".validate": "$i.matches(/^[0-7]$/) && newData.hasChildren(['name']) && (newData.hasChild('picks') || newData.hasChild('note'))",
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "picks": { ".validate": "newData.hasChildren()", "$pick": { ".validate": "newData.val() === true && $pick.matches(/^(vegetarian|vegan|pescatarian|glutenfree|dairyfree|nuts|shellfish|nopork|noalcohol|none)$/)" } },
              "note": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "songs": {
          ".write": "now < 1810422000000 && (!newData.exists() || root.child('household').child($token).child('reply').child('answer').val() === 'yes')",
          ".validate": "newData.hasChildren(['list', 'at'])",
          "at": { ".validate": "newData.val() == now" },
          "list": {
            ".validate": "newData.hasChild('0') && (!newData.hasChild('2') || newData.hasChild('1')) && (!newData.hasChild('1') || newData.child('1/id').val() != newData.child('0/id').val()) && (!newData.hasChild('2') || (newData.child('2/id').val() != newData.child('0/id').val() && newData.child('2/id').val() != newData.child('1/id').val()))",
            "$i": {
              ".validate": "$i.matches(/^[0-2]$/) && newData.hasChildren(['id', 'title', 'artist'])",
              "id": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,12}$/) && !root.child('board').child('hidden').child(newData.val()).exists()" },
              "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
              "artist": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "pub": {
          ".write": "!data.exists() && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{20}$/) && root.child('songOwner').child(newData.val()).val() === $token"
        },
        "$other": { ".validate": false }
      }
    },
    "songOwner": {
      "$pub": {
        ".write": "!data.exists() && $pub.matches(/^[A-Za-z0-9_-]{20}$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,64}$/) && root.child('welcome').child(newData.val()).exists()"
      }
    },
    "board": {
      ".read": true,
      "picks": {
        "$pub": {
          ".write": "root.child('songOwner').child($pub).exists() && root.child('household').child(root.child('songOwner').child($pub).val()).child('pub').val() === $pub && (newData.exists() || !root.child('household').child(root.child('songOwner').child($pub).val()).child('songs').exists())",
          ".validate": "root.child('songOwner').child($pub).exists() && newData.child('0').val() === root.child('household').child(root.child('songOwner').child($pub).val()).child('songs/list/0/id').val() && newData.child('1').val() === root.child('household').child(root.child('songOwner').child($pub).val()).child('songs/list/1/id').val() && newData.child('2').val() === root.child('household').child(root.child('songOwner').child($pub).val()).child('songs/list/2/id').val()",
          "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isString()" }
        }
      },
      "hidden": {
        "$id": { ".validate": "$id.matches(/^[0-9]{1,12}$/) && newData.val() === true" }
      }
    },
    "travel": {
      "$token": {
        ".validate": "root.child('welcome').child($token).exists()",
        "$n": {
          ".write": "$n.matches(/^[0-7]$/) && root.child('household').child($token).child('reply').child('answer').val() === 'yes'",
          ".validate": "newData.hasChildren(['from', 'last', 'arrive', 'leave', 'at'])",
          "from": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3,6}$/)" },
          "to": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3,5}$/)" },
          "toText": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "via": { ".validate": "newData.val() === 'direct' || newData.val() === 'change'" },
          "last": { ".validate": "newData.val() === 'hire' || newData.val() === 'lift' || newData.val() === 'taxi' || newData.val() === 'public' || newData.val() === 'own'" },
          "arrive": { ".validate": "newData.val() === 'early' || newData.val() === 'thu' || newData.val() === 'fri' || newData.val() === 'sat'" },
          "leave": { ".validate": "newData.val() === 'sun' || newData.val() === 'mon' || newData.val() === 'later'" },
          "who": { ".validate": "newData.hasChildren()", "$i": { ".validate": "newData.isBoolean() && $i.matches(/^[0-7]$/)" } },
          "at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    },
    "welcomeSeen": {
      "$token": {
        "last": {
          ".write": "newData.hasChildren(['at', 'key']) && newData.child('at').val() == now && (!data.exists() || now - data.child('at').val() >= 60000) && root.child('welcome').child($token).exists()",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().length == 20"
          },
          "$other": {
            ".validate": false
          }
        },
        "$seen": {
          ".write": "!data.exists() && newData.val() == now && $seen.length == 20 && newData.parent().child('last').child('key').val() == $seen && root.child('welcome').child($token).exists()"
        }
      }
    }
  }
}
