{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
    ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
    "public": {
      "profiles": {
        "$uid": {
          ".validate": "newData.hasChildren(['name'])"
        }
      },
      "config": {
        ".read": true
      }
    },
    "registrations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['name', 'email', 'intent'])"
      }
    },
    "members": {
      "payment": {
        ".read": "auth != null && root.child('approved').child(auth.uid).val() === true"
      }
    },
    "approved": {
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },
    "payments": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "welcome": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$token": {
        ".read": true,
        ".validate": "newData.hasChildren(['display', 'lines'])",
        "people": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        }
      }
    },
    "household": {
      "$token": {
        ".read": true,
        ".validate": "root.child('welcome').child($token).exists()",
        "reply": {
          ".write": "now < 1803859200000",
          ".validate": "newData.hasChildren(['answer', 'coming', 'at'])",
          "answer": { ".validate": "newData.val() === 'yes' || newData.val() === 'no'" },
          "coming": { ".validate": "newData.hasChildren()", "$i": { ".validate": "newData.isBoolean() && $i.matches(/^[0-7]$/)" } },
          "at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        },
        "stay": {
          ".write": "root.child('household').child($token).child('reply').child('answer').val() === 'yes' && (now < 1803859200000 || !data.exists() || data.child('choice').val() === 'later')",
          ".validate": "newData.hasChildren(['choice', 'at'])",
          "choice": { ".validate": "newData.val() === 'villa' || newData.val() === 'own' || newData.val() === 'later'" },
          "at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "travel": {
      "$token": {
        ".validate": "root.child('welcome').child($token).exists()",
        "$n": {
          ".write": "$n.matches(/^[0-7]$/) && root.child('household').child($token).child('reply').child('answer').val() === 'yes'",
          ".validate": "newData.hasChildren(['from', 'last', 'arrive', 'leave', 'at'])",
          "from": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3,6}$/)" },
          "to": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3,5}$/)" },
          "toText": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "via": { ".validate": "newData.val() === 'direct' || newData.val() === 'change'" },
          "last": { ".validate": "newData.val() === 'hire' || newData.val() === 'lift' || newData.val() === 'taxi' || newData.val() === 'public' || newData.val() === 'own'" },
          "arrive": { ".validate": "newData.val() === 'early' || newData.val() === 'thu' || newData.val() === 'fri' || newData.val() === 'sat'" },
          "leave": { ".validate": "newData.val() === 'sun' || newData.val() === 'mon' || newData.val() === 'later'" },
          "who": { ".validate": "newData.hasChildren()", "$i": { ".validate": "newData.isBoolean() && $i.matches(/^[0-7]$/)" } },
          "at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    },
    "welcomeSeen": {
      "$token": {
        "last": {
          ".write": "newData.hasChildren(['at', 'key']) && newData.child('at').val() == now && (!data.exists() || now - data.child('at').val() >= 60000) && root.child('welcome').child($token).exists()",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().length == 20"
          },
          "$other": {
            ".validate": false
          }
        },
        "$seen": {
          ".write": "!data.exists() && newData.val() == now && $seen.length == 20 && newData.parent().child('last').child('key').val() == $seen && root.child('welcome').child($token).exists()"
        }
      }
    }
  }
}
